<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>User Master - Live List</title>

  <!-- CSS -->
  <style>
    :root {
      --bg-color: #f4f7fb;
      --card-bg: #ffffff;
      --primary: #2563eb;
      --primary-light: #dbeafe;
      --text-dark: #1e293b;
      --text-muted: #64748b;
      --border: #e2e8f0;
    }

    body {
      font-family: sans-serif;
      margin: 0;
      background: var(--bg-color);
      color: var(--text-dark);
      padding: 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    h1 {
      font-size: 26px;
      font-weight: 700;
      color: #0a5ff3;
      margin-bottom: 16px;
      letter-spacing: 0.5px;
    }

    .card {
      background: var(--card-bg);
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(15,23,42,0.08);
      width: 100%;
      max-width: 950px;
      animation: fadeIn 0.6s ease;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    th, td {
      text-align: left;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      font-size: 15px;
    }

    th {
      background: var(--primary-light);
      color: #0a5ff3;
      font-weight: 700;
      font-size: 13px;
    }

    tr:hover {
      background: #f9fafb;
      transition: background 0.2s ease-in-out;
    }

    tr.new-row {
      animation: highlight 2.5s ease;
    }

    @keyframes highlight {
      0% { background: #dbf1d5; }
      100% { background: transparent; }
    }

    .muted {
      color: var(--text-muted);
      font-size: 14px;
      margin-top: 6px;
    }

    .badge {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 999px;
      background: #6f9cea;
      color: #0a5ff3;
      font-weight: 600;
      font-size: 12px;
    }

    .no-data {
      text-align: center;
      padding: 24px;
      color:  #000000;;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <h1>User Master</h1>
  <div class="card">
    <table id="usersTable" aria-live="polite">
      <thead>
        <tr>
          <th>S.no</th>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Created By</th>
          <th>Created At</th>
        </tr>
      </thead>
      <tbody id="tbody">
        <% if (users && users.length > 0) { %>
          <% users.forEach(function(user, idx){ %>
            <tr data-id="<%= user.id %>">
              <td><%= idx + 1 %></td> <!-- S.no -->
              <td><%= user.full_name %></td>
              <td><%= user.email %></td>
              <td><%= user.phone_number %></td>
              <td><%= user.created_by %></td>
              <td><%= new Date(user.created_dt).toLocaleString() %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr class="no-data"><td colspan="6">No records found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Socket.IO client script (served by server) -->
  <script src="/socket.io/socket.io.js"></script>

  <!-- inline JS to listen for socket events and update table live -->
  <script>
    (function(){
      const socket = io();

      function addRow(user) {
        const tbody = document.getElementById("tbody");
        const noDataRow = tbody.querySelector(".no-data");
        if (noDataRow) noDataRow.remove();

        const tr = document.createElement("tr");
        tr.classList.add("new-row");
        tr.setAttribute("data-id", user.id);

        const createdAt = user.created_dt ? new Date(user.created_dt).toLocaleString() : new Date().toLocaleString();

        // Calculate next sequential S.no based on visible rows
        const currentRows = tbody.querySelectorAll("tr").length;
        const serialNo = currentRows + 1;

        tr.innerHTML = `
          <td>${serialNo}</td>
          <td>${escapeHtml(user.full_name)}</td>
          <td>${escapeHtml(user.email)}</td>
          <td>${escapeHtml(user.phone_number)}</td>
          <td>${escapeHtml(user.created_by || "")}</td>
          <td>${createdAt}</td>
        `;

        // append at bottom (ascending S.no)
        tbody.appendChild(tr);
        setTimeout(()=> tr.classList.remove("new-row"), 2500);
      }

      socket.on("user:created", (user) => {
        addRow(user);
      });

      function escapeHtml(text) {
        if (text === null || text === undefined) return "";
        return String(text)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }
    })();
  </script>
</body>
</html>
